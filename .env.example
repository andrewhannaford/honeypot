# Copy this file to .env and fill in your values

# This honeypot makes no outbound HTTPS calls of its own and holds no Discord
# webhook secret — it's designed to be compromised, so it shouldn't be able to
# call out anywhere. alerts/discord.py queues formatted alerts into a local
# alert_outbox table instead; point something on your trusted network at
# /api/alerts/pending (and have it POST /api/alerts/ack once delivered) to
# actually send them. See README.md.
#
# Shared token guarding /api/alerts/pending, /api/alerts/ack, and
# /api/events/since. Required for those endpoints to work at all — empty
# means they refuse every request (fail closed). Generate something random.
OUTBOX_TOKEN=
# Max rows kept in alert_outbox if nothing is draining it.
# ALERT_OUTBOX_MAX=5000

# AbuseIPDB API key for threat intel enrichment (leave blank to disable)
ABUSEIPDB_API_KEY=

# VirusTotal API key for payload analysis (leave blank to disable)
VIRUSTOTAL_API_KEY=

# Reverse proxies whose X-Forwarded-For header the HTTP trap should trust, so
# proxied attacker traffic is attributed to the real attacker IP instead of
# the proxy's. Only honoured when the DIRECT peer is in this list. Leave
# blank if nothing sits in front of the honeypot. Comma-separated.
TRUSTED_PROXIES=

# Discord alert toggles — 0/false/no/off to disable (default: enabled)
# ALERT_ON_CONNECT=1
# ALERT_ON_CREDENTIAL=1
# ALERT_ON_EXEC=1
# ALERT_ON_DOWNLOAD=1

# Seconds between duplicate Discord alerts for the same IP + alert type (bad values → 60)
# DISCORD_ALERT_COOLDOWN=60

# Honeypot location for the attack-map "victim" pin (decimal degrees). If
# left blank, it's auto-detected from your public IP via ipinfo.io on
# startup — set these explicitly if you don't want that outbound call, or
# don't want your real location on the map.
# SERVER_LAT=51.5074
# SERVER_LON=-0.1278

# Network interface Suricata should sniff (run "ip link show" to find yours)
# SURICATA_IFACE=ens33

# HTTPS trap
# HTTPS_PORT=8443
# HTTPS_CERT_CN=web-prod-01.internal

# Database trap banners
# MYSQL_VERSION=5.7.44-log
# POSTGRES_VERSION=13.11
