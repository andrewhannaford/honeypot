# Runtime data — never commit
data/
logs/
*.db
*.jsonl

# Suricata rules the dashboard's rule builder writes at runtime (rule_builder.py),
# and its control-socket directory — not source, would just create pointless
# conflicts with a live deployment's actual rule set on every git pull. setup.sh
# creates an initial empty custom.rules on first deploy.
custom.rules
run/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Environment — contains secrets
.env

# SSH host key generated at runtime
data/ssh_host_key
data/ssh_host_key.pub

# macOS
.DS_Store
